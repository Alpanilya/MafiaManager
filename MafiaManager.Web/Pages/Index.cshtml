@page
@model IndexModel
@{
    ViewData["Title"] = "Панель Ведущего";
}

<style>
    body, html {
        height: 100%;
        background-color: #212529;
    }
</style>

<div id="gameBoard" 
     class="container-fluid bg-dark text-white h-100 p-3 d-flex flex-column">
    <div class="row g-3 h-100">
        <div class="col-lg-3 col-md-4 d-flex flex-column">
            <div class="card bg-dark border-secondary border-2 text-center mb-3 text-white">
                <div class="card-body">
                    <h2 class="fw-bold mb-0">
                        ☀️ ДЕНЬ | 🌙 НОЧЬ'
                    </h2>
                    <span class="fs-5 fw-bold">
                        Круг #
                    </span>
                </div>
            </div>

            <div class="card bg-dark border-secondary border-2 text-center mb-3 text-white">
                <div class="card-body">
                    <h6 class="text-uppercase text-secondary fw-bold mb-1">Оставшееся время</h6>
                    <div class="display-3 font-monospace fw-bold mb-3" :class="{'text-danger': timeLeft <= 10}">
                        01:00
                    </div>
                    <div class="btn-group gap-1">
                        <button class="btn btn-primary btn-sm fw-bold">
                            ▶️ Старт (⏸ Пауза)
                        </button>
                        <button class="btn btn-danger btn-sm fw-bold">
                            🔄 Сброс
                        </button>
                    </div>
                </div>
            </div>

            <div class="card bg-dark border-secondary border-2 text-center mb-3 text-white">
                <div class="card-body">
                    <div class="btn-group flex-column gap-2">
                        <button class="btn btn-danger fw-bold py-2" @@click="nextPhase">
                            Перейти к фазе: 🌙 Ночь | ☀️ День
                        </button>

                        <button class="btn btn-primary py-2">
                            ⚖️ Начать голосование
                        </button>
                    </div>
                </div>
            </div>

            <div class="card bg-dark border-secondary border-2 text-center mb-3 text-white flex-grow-1">
                <div class="card-header border-secondary fw-bold text-uppercase text-secondary">
                    📜 Сводка событий
                </div>
                <div class="card-body overflow-auto">
                    @* <div v-for="(entry, index) in logs" :key="index" class="mb-2 pb-2 border-bottom border-secondary"> *@
                    <div class="mb-2 pb-2 border-bottom border-secondary">
                        <span class="text-secondary small">21:28:00</span><br>
                        <span class="text-light">
                            Игра началась!
                        </span>
                    </div>
                    <div class="text-light text-center mt-4">
                        Событий пока нет...
                    </div>
                </div>
            </div>
         </div>

        @* <div v-if="player.isDead" class="text-danger fw-bold mb-1">💀 МЁРТВ</div> *@

        <div class="col-lg-9 col-md-8 d-flex flex-column">
            <div class="card bg-dark border-secondary border-2 text-center mb-3 text-white flex-grow-1">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-white">👥 Игроки за столом</h5>
                    <span class="badge bg-secondary">Живых: {{ game.getRolesStats() }}</span>
                </div>

                <div class="card-body overflow-auto p-4">
                    <div class="row row-cols-2 row-cols-sm-3 g-3">
                        <div v-for="player in game.getGamePlayers()"
                             :key="getEntityId(player)"
                                class="col">
                            <div class="card bg-dark text-white border-2 text-center flex-column mb-3 p-3"
                                 :style="{ borderColor: getRoleColor(getPlayerRole(player)) }">
                                <div class="display-6 fw-bold"> {{ getEntityId(player) }}</div>

                                <small class="text-uppercase mt-1">{{ getEntityName(player) }}</small>
                                <div class="badge mt-2" :style="{ backgroundColor: getRoleColor(getPlayerRole(player)) }">
                                        {{ getEntityName(getPlayerRole(player), 'Без роли') }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
     </div>

    <partial name="_Settings" />
</div>



@Html.AntiForgeryToken()

<script type="module" src="~/js/game.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>