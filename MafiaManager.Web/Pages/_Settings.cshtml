@using System.Text.Json
@model MafiaManager.Core.Entities.GameSettings

<div id="settingsModal" 
     class="modal fade"
     data-bs-backdrop="static" 
     data-bs-keyboard="false" 
     tabindex="-1" 
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary shadow-lg">

            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">⚙️ Настройки новой игры</h5>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label  for="playerCount" 
                            class="form-label fw-semibold">
                            Количество игроков:
                    </label>

                    <input type="number" 
                            class="form-control bg-body-tertiary border-secondary"
                            id="playerCount"
                            v-model.number="playersCount"
                            min="0" 
                            max="100"
                            required>
                </div>

                <div class="mb-3">
                    <label for="timeDelay" 
                           class="form-label fw-semibold">Время на ходы (сек)
                    </label>

                    <input type="number" 
                            class="form-control bg-body-tertiary border-secondary" 
                            id="timeDelay" 
                            min="0"
                            value="@Model.TimeDelay"
                            required>
                </div>

                <partial name="_RolesList" />

                <partial name="_PlayerList" />
            </div>

            <div class="modal-footer border-secondary overflow-y-auto">
                <button type="button" 
                        class="btn btn-danger w-100 fw-bold py-2" 
                        onclick="startGame()">
                    Начать игру
                </button>
            </div>
        </div>
    </div>
</div>

<script type"module">
    @{
        var settingsJson = JsonSerializer.Serialize(Model);
    }

    window.gameSettings = @Html.Raw(settingsJson);

</script>

<script type="module" src="~/js/settings.js"></script>